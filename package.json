{
  "name": "google-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "server:prod": "NODE_ENV=production tsx server/index.ts",
    "electron:dev": "electron desktop/main.js",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "ogl": "1.0.11",
    "react-dom": "^19.2.3",
    "@google/genai": "^1.37.0",
    "peerjs": "1.5.2",
    "express": "^4.21.2",
    "dotenv": "^17.2.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "main": "desktop/main.js",
  "build": {
    "appId": "com.googleos.app",
    "productName": "Google OS",
    "files": [
      "dist/**/*",
      "desktop/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": { "category": "public.app-category.productivity" },
    "linux": { "target": "AppImage", "category": "Office" },
    "win": { "target": "nsis" }
  }
}
