# Chave da API do Gemini (Google AI Studio)
# Acesse: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_aqui

# ------------------------------------------------------------------
# Variáveis abaixo são usadas apenas pelo backend opcional (server/)
# herdado do Google Workspace Hub. O frontend funciona sem elas.
# ------------------------------------------------------------------

# Senha usada para criptografar (AES-256) credenciais e tokens em disco.
ENCRYPTION_SECRET=algo_seguro_com_pelo_menos_32_caracteres_aqui

# URL pública onde o app está hospedado (usada nos callbacks do OAuth).
APP_URL=http://localhost:3000

# Credenciais OAuth 2.0 do Google Cloud Console (Credenciais -> OAuth 2.0 Web Client).
# Se preenchidas, o backend habilita sincronização REAL com Google Calendar e Google Tasks.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
